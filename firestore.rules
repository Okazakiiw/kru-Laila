// Firestore Security Rules — แทนที่ใน Firebase Console → Firestore → Rules แล้วกด Publish
//
// เป้าหมาย:
//   - ใครก็อ่านประกาศได้ (เว็บ public)
//   - เขียน/ลบได้เฉพาะ "แอดมินที่อยู่ในรายชื่อ" (collection admins/{uid})
//   - ลูกค้าส่งฟอร์ม "สนใจประกาศนี้" ได้ (สร้าง /leads ได้อย่างเดียว อ่านไม่ได้)
//
// ⚠️ ก่อน Publish: ต้องสร้างเอกสาร admins/{UID ของคุณ} ก่อน (ไม่ต้องมี field ก็ได้)
//    UID ดูได้ในหน้า admin.html หลังล็อกอิน หรือ Firebase Console → Authentication → Users
//    ถ้าลืมขั้นตอนนี้ หน้า admin จะบันทึกไม่ได้ (แจ้ง "สิทธิ์ไม่พอ")
//
// ทำไมต้องเปลี่ยน: rules เดิมใช้ request.auth != null = "ใครล็อกอินก็เป็นแอดมิน"
//   แต่ Firebase เปิด API สมัครสมาชิก (accounts:signUp) ให้ใครก็ได้ที่มี apiKey (ซึ่งอยู่ใน HTML)
//   → คนแปลกหน้าสร้างบัญชีเองแล้วลบ/แก้ประกาศทั้งหมดได้

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────── helpers (ต้องอยู่ภายใน service) ───────
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validListing(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
          && (!('desc' in d) || d.desc is string && d.desc.size() <= 5000)
          && (!('fbUrl' in d) || d.fbUrl is string && d.fbUrl.size() <= 500)
          && (!('imageObjs' in d) || d.imageObjs is list && d.imageObjs.size() <= 30);
    }

    // อนุญาตให้ "ใครก็ได้" เพิ่ม views ทีละ 1 เท่านั้น (เปลี่ยน field อื่นไม่ได้) — สำหรับตัวนับยอดดู
    function isViewIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is int
          && request.resource.data.views == (('views' in resource.data) ? resource.data.views : 0) + 1;
    }

    function validLead(d) {
      return d.keys().hasOnly(['listingId','listingTitle','name','contact','message','handled','createdAt'])
          && d.listingId is string && d.listingId.size() <= 100
          && d.listingTitle is string && d.listingTitle.size() <= 200
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 30
          && d.message is string && d.message.size() <= 1000
          && d.handled == false
          && d.createdAt == request.time;
    }

    // ─────── ประกาศ ───────
    match /listings/{id} {
      allow read: if true;
      allow create: if isAdmin() && validListing(request.resource.data);
      allow update: if (isAdmin() && validListing(request.resource.data))
                    || isViewIncrement();
      allow delete: if isAdmin();
    }

    // ─────── เมตาดาต้าทั่วเว็บ (รายชื่อประเภท, การตั้งค่าทั่วเว็บ) ───────
    match /meta/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────── ลูกค้าที่สนใจ (ฟอร์มในหน้าประกาศ) ───────
    // คนทั่วไป: สร้างได้อย่างเดียว · แอดมิน: อ่าน/ทำเครื่องหมาย/ลบ
    match /leads/{id} {
      allow create: if validLead(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handled']);
    }

    // ─────── รายชื่อแอดมิน: แก้ได้จาก Firebase Console เท่านั้น ───────
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // กันทุก path อื่นโดย default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
